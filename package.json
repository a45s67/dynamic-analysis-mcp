{
  "name": "dynamic-analysis-mcp-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.20.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:exe": "bun build src/main.ts --compile --target=bun-windows-x64 --no-compile-autoload-dotenv --no-compile-autoload-bunfig --outfile dist/dynamic-analysis-mcp-gateway.exe",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1",
    "test:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-install.ps1",
    "verify:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-package.ps1",
    "check": "npm run typecheck && npm test",
    "check:config": "node dist/main.js --check-config",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "smol-toml": "1.8.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@oven/bun-windows-x64": "1.4.0",
    "@types/node": "24.13.3",
    "bun": "1.4.0",
    "typescript": "6.0.2",
    "vitest": "4.1.11"
  }
}
